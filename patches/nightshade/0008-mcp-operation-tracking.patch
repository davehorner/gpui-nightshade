+pub fn finish_operations(stage: crate::resources::Stage, storage: &mut nightshade::ecs::Storage) {
+    let ready = stage.viewer.operations.ready();
+    for (id, tool, target) in ready {
+        if tool == "set_morph_weight" {
+            let result = target
+                .ok_or_else(|| "operation target is missing".to_string())
+                .and_then(|id| crate::queries::agent::resolve(storage, id))
+                .and_then(|entity| {
+                    storage
+                        .get::<nightshade_render::components::morph::MorphWeights>(entity)
+                        .map(|w| serde_json::json!({"entity": entity.id, "weights": w.weights}))
+                        .ok_or_else(|| "the node has no morph weights".to_string())
+                });
+            stage
+                .viewer
+                .operations
+                .finish(&id, stage.viewer.history.frame, result);
+            continue;
+        }
+        let result = match tool.as_str() {
+            "set_playback"
+            | "toggle_playback"
+            | "set_animation"
+            | "set_animation_layer_weight"
+            | "play_clip"
+            | "stop_animation"
+            | "add_animation_layer"
+            | "remove_animation_layer" => crate::queries::agent::animation_state(&stage),
+            "add_primitive" | "add_light" | "delete_entity" | "rename_entity" | "set_visible"
+            | "isolate" => crate::queries::agent::scene_state(&stage),
+            "select_entity" | "undo" | "redo" => crate::queries::agent::selection_state(&stage),
+            _ => crate::queries::agent::viewer_state(&stage),
+        };
+        let tick = stage.viewer.history.frame;
+        stage.viewer.operations.finish(&id, tick, Ok(result));
+    }
+}
