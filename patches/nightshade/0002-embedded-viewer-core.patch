+/// Retained-mode native frontend; attach after ViewerCorePlugin and UiPlugin.
+pub struct NativeViewerUiPlugin;
+impl Plugin for NativeViewerUiPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_system(Stage::Startup, native_preview_visibility);
+        app.add_system(Stage::Startup, systems::interface::build_ui);
+        app.add_system(
+            Stage::Update,
+            (
+                systems::input::handle_events,
+                systems::interface::relayout,
+                systems::poll::poll_ui,
+                native_pointer_capture,
+                systems::browsers::poll_browsers,
+                systems::previews::upload_previews,
+                systems::library::draw_previews,
+                systems::lists::rebuild_lists,
+                systems::refresh::refresh_ui,
+                systems::nav_gizmo::draw_nav_gizmo,
+            ),
+        );
+        let schedule = app.stages.stage_mut(Stage::Update.name());
+        macro_rules! order {
+            ($a:path,$b:path) => {
+                schedule.order(
+                    std::any::type_name_of_val(&$a),
+                    std::any::type_name_of_val(&$b),
+                );
+            };
+        }
+        order!(systems::input::handle_events, systems::interface::relayout);
+        order!(systems::interface::relayout, systems::poll::poll_ui);
+        order!(systems::poll::poll_ui, native_pointer_capture);
+        order!(native_pointer_capture, systems::gizmo::update_gizmo);
+        order!(
+            systems::browsers::announce_indices,
+            systems::browsers::poll_browsers
+        );
+        order!(systems::browsers::poll_browsers, systems::load::poll_load);
+        order!(
+            systems::skeleton::update_skeleton,
+            systems::previews::upload_previews
+        );
+        order!(
+            systems::previews::upload_previews,
+            systems::library::draw_previews
+        );
+        order!(
+            systems::library::draw_previews,
+            systems::library::hold_preview_capture
+        );
+        order!(
+            systems::library::hold_preview_capture,
+            systems::lists::rebuild_lists
+        );
+        order!(systems::lists::rebuild_lists, systems::refresh::refresh_ui);
+        order!(
+            systems::refresh::refresh_ui,
+            systems::nav_gizmo::draw_nav_gizmo
+        );
+        order!(
+            systems::nav_gizmo::draw_nav_gizmo,
+            systems::settings::save_settings
+        );
+    }
+}
+fn native_preview_visibility(
+    arguments: Res<ViewerArguments>,
