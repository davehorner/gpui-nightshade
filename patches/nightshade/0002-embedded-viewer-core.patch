+                no_agent: true,
+                ..Default::default()
+            },
+        );
+        app.add_plugin(nightshade_text::TextPlugin)
+            .add_plugin(nightshade_animation::AnimationPlugin)
+            .add_plugin(nightshade_camera_controller::CameraControllerPlugin)
+            .add_plugin(nightshade_gltf::GltfPlugin)
+            .add_plugin(nightshade_ui::UiPlugin::new())
+            .add_plugin(crate::ViewerPlugin);
+        app.stages.apply_orderings();
+        app.startup.run(&mut app.world);
+        assert!(
+            app.world
+                .resources
+                .contains::<nightshade_ui::resources::RetainedUiRuntime>()
+        );
+        assert!(
+            !app.world
+                .res::<nightshade_ui::resources::RetainedUiRuntime>()
+                .visible
+        );
+        assert!(
+            app.world
+                .res::<nightshade_platform::contract::window::Window>()
+                .handle
+                .is_none()
+        );
+    }
+    #[test]
+    fn actions_and_snapshots_work_without_retained_ui() {
+        let mut app = compose(
+            ViewerArguments {
+                no_agent: true,
+                preview: true,
+                ..Default::default()
+            },
+            ViewerCorePlugin {
+                persist_settings: false,
+                remote_catalogs: false,
+            },
+        );
+        assert!(
+            !app.world
+                .resources
+                .contains::<nightshade_ui::resources::RetainedUiRuntime>()
+        );
+        app.startup.run(&mut app.world);
+        submit(
+            &mut app.world,
+            ViewerAction::AddPrimitive(PrimitiveKind::Cube),
+        )
+        .unwrap();
+        for _ in 0..3 {
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+        }
+        let initial = snapshot(&app.world);
+        let entity = initial.nodes[0].entity;
+        submit(&mut app.world, ViewerAction::Select(Some(entity))).unwrap();
+        submit(&mut app.world, ViewerAction::Rename("Core cube".into())).unwrap();
+        submit(&mut app.world, ViewerAction::SetTranslation([1., 2., 3.])).unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        let edited = snapshot(&app.world);
+        assert_eq!(edited.selection.name, "Core cube");
+        assert_eq!(edited.selection.translation, [1., 2., 3.]);
+        assert!(edited.can_undo);
+        submit(&mut app.world, ViewerAction::Undo).unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        assert_eq!(snapshot(&app.world).selection.translation, [0., 0., 0.]);
+        assert_eq!(
+            edited.selection.translation,
+            [1., 2., 3.],
+            "snapshots must own their state"
+        );
+    }
+}
+
+pub fn request_pick(world: &mut World, x: u32, y: u32) {
+    let viewer = world.res_mut::<crate::resources::ViewerResources>();
+    viewer.picking.click_wanted = Some(nightshade::prelude::nalgebra_glm::vec2(x as f32, y as f32));
+    viewer.picking.click_adds = false;
+}
+pub fn pick_pending(world: &World) -> bool {
+    let viewer = world.res::<crate::resources::ViewerResources>();
+    viewer.picking.click_wanted.is_some() || viewer.picking.outstanding.is_some()
+}
