+/// Compose the same native renderer/plugin stack without parsing process arguments or starting an event loop.
+pub fn compose_embedded<A: Send + Sync + 'static>(opening: Opening, arguments: A) -> App {
+    let mut app = App::new();
+    app.add_plugin(nightshade_window::WindowPlugin {
+        title: opening.title.to_string(),
+        size: opening.size,
+    });
+    app.add_plugin(nightshade_log::LogPlugin {
+        title: Some(opening.title.to_string()),
+        ..Default::default()
+    });
+    #[cfg(feature = "wgpu")]
+    app.add_plugin(nightshade_wgpu::RenderPlugin {
+        vsync: opening.vsync,
+        frame_rate_limit: opening.frame_rate_limit,
+    });
+    #[cfg(feature = "vulkan")]
+    app.add_plugin(nightshade_vulkan::RenderPlugin {
+        vsync: opening.vsync,
+        frame_rate_limit: opening.frame_rate_limit,
+    });
+    app.add_plugin(nightshade_camera::CameraPlugin);
+    app.insert_resource(arguments);
+    finish(app, opening)
+}
