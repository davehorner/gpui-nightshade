+    #[test]
+    fn native_mcp_round_trip_edits_the_frontend_world() {
+        use serde_json::{Value, json};
+        use std::{
+            io::{Read, Write},
+            net::{TcpListener, TcpStream},
+            sync::mpsc,
+            time::{Duration, Instant},
+        };
+        fn call(port: u16, name: &str, arguments: Value) -> Value {
+            let body=json!({"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":name,"arguments":arguments}}).to_string();
+            let mut stream = TcpStream::connect(("127.0.0.1", port)).unwrap();
+            stream
+                .set_read_timeout(Some(Duration::from_secs(5)))
+                .unwrap();
+            write!(stream,"POST / HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",body.len(),body).unwrap();
+            let mut response = String::new();
+            stream.read_to_string(&mut response).unwrap();
+            let (_, body) = response.split_once("\r\n\r\n").unwrap();
+            let response: Value = serde_json::from_str(body).unwrap();
+            assert!(response.get("error").is_none(), "{response}");
+            response["result"]["structuredContent"].clone()
+        }
+        let reservation = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let port = reservation.local_addr().unwrap().port();
+        drop(reservation);
+        let mut app = compose(
+            ViewerArguments {
+                preview: true,
+                agent_port: Some(port),
+                ..Default::default()
+            },
+            ViewerCorePlugin {
+                persist_settings: false,
+                remote_catalogs: false,
+            },
+        );
+        app.stages.apply_orderings();
+        app.startup.run(&mut app.world);
+        submit(
+            &mut app.world,
+            ViewerAction::AddPrimitive(PrimitiveKind::Cube),
+        )
+        .unwrap();
+        for _ in 0..3 {
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+        }
+        let entity = snapshot(&app.world).nodes[0].entity;
+        let (sender, receiver) = mpsc::channel();
+        let client = std::thread::spawn(move || {
+            let scene = call(port, "get_scene", json!({}));
+            assert!(
+                scene["nodes"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .any(|node| node["entity"] == entity.id)
+            );
+            call(port, "select_entity", json!({"entity":entity.id}));
+            call(
+                port,
+                "rename_entity",
+                json!({"entity":entity.id,"name":"From MCP"}),
+            );
+            call(
+                port,
+                "set_transform",
+                json!({"entity":entity.id,"translation":[5.,2.,1.]}),
+            );
+            let transform = call(port, "get_transform", json!({"entity":entity.id}));
+            sender.send(transform).unwrap();
+        });
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let result = loop {
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+            if let Ok(result) = receiver.try_recv() {
+                break result;
+            }
+            assert!(Instant::now() < deadline, "MCP client did not complete");
+            std::thread::sleep(Duration::from_millis(1));
+        };
+        client.join().unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        let state = snapshot(&app.world);
+        assert_eq!(result["translation"], json!([5., 2., 1.]));
+        assert_eq!(state.selection.name, "From MCP");
+        assert_eq!(state.selection.translation, [5., 2., 1.]);
+        assert!(
+            !app.world
+                .resources
+                .contains::<nightshade_ui::resources::RetainedUiRuntime>()
+        );
+        let mut crew = app
+            .world
+            .res::<crate::resources::ViewerResources>()
+            .incoming
+            .crew
+            .clone();
+        crate::commands::crew::wait_for_the_crew(&mut crew);
+    }
