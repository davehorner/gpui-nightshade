+
+pub fn take_arguments<T: DeserializeOwned>(arguments: Value) -> Result<T, String> {
+    fn representable(value: &Value) -> bool {
+        match value {
+            Value::Number(n) => n
+                .as_f64()
+                .is_some_and(|n| n.is_finite() && n.abs() <= f32::MAX as f64),
+            Value::Array(items) => items.iter().all(representable),
+            Value::Object(fields) => fields.values().all(representable),
+            _ => true,
+        }
+    }
+    if !representable(&arguments) {
+        return Err("numeric arguments must fit finite 32-bit values".into());
+    }
+    serde_json::from_value(if arguments.is_null() {
+        json!({})
+    } else {
+        arguments
+    })
+    .map_err(|error| format!("those arguments do not fit: {error}"))
 }
 
