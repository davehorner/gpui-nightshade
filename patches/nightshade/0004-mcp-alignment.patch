+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn protocol_rejects_invalid_calls_without_queueing() {
+        let queue = AgentChannel::default();
+        for (body, code) in [
+            ("{", -32700),
+            (r#"{"id":1,"method":"tools/list"}"#, -32600),
+            (
+                r#"{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"missing"}}"#,
+                -32602,
+            ),
+            (
+                r#"{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"undo","arguments":[]}}"#,
+                -32602,
+            ),
+        ] {
+            assert_eq!(answer_message(&queue, body).unwrap()["error"]["code"], code);
+        }
+        assert!(
+            answer_message(
+                &queue,
+                r#"{"jsonrpc":"2.0","method":"tools/call","params":{"name":"undo"}}"#
+            )
+            .is_none()
+        );
+        assert!(take_pending(&queue).is_empty());
+    }
+
+    #[test]
+    fn execution_errors_and_success_have_distinct_envelopes() {
+        for (reply, expected) in [
+            (Err("invalid entity".to_string()), true),
+            (Ok(json!({"queued":true})), false),
+        ] {
+            let queue = AgentChannel::default();
+            let client_queue = queue.clone();
+            let client = std::thread::spawn(move || {
+                queue_call(&client_queue, Some(json!(7)), json!({"name":"undo"}))
+            });
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+            let pending = loop {
+                if let Some(call) = take_pending(&queue).pop() {
+                    break call;
+                }
+                assert!(std::time::Instant::now() < deadline);
+                std::thread::yield_now();
+            };
+            pending.reply.send(reply).unwrap();
+            let result = client.join().unwrap();
+            assert_eq!(result["id"], 7);
+            assert_eq!(result["result"]["isError"], expected);
+            let text: Value =
+                serde_json::from_str(result["result"]["content"][0]["text"].as_str().unwrap())
+                    .unwrap();
+            assert_eq!(text, result["result"]["structuredContent"]);
+        }
+    }
+
+    #[test]
+    fn expired_calls_are_discarded_and_queue_is_bounded() {
+        let queue = AgentChannel::default();
+        let make = |deadline| Pending {
+            name: "undo".into(),
+            arguments: json!({}),
+            reply: channel().0,
+            deadline,
+        };
+        queue_pending(&queue, make(std::time::Instant::now())).unwrap();
+        assert!(take_pending(&queue).is_empty());
+        for _ in 0..MAX_PENDING_CALLS {
+            queue_pending(&queue, make(std::time::Instant::now() + CALL_TIMEOUT)).unwrap();
+        }
+        assert!(queue_pending(&queue, make(std::time::Instant::now() + CALL_TIMEOUT)).is_err());
+        assert_eq!(take_pending(&queue).len(), MAX_PENDING_CALLS);
+    }
+}
