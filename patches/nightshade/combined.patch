@@ -0,0 +1,69 @@
+use super::{WgpuRenderer, rendergraph::render_graph_set_external_texture};
+
+impl WgpuRenderer {
+    /// Allocate a GPU output, retaining all normal scene and presentation passes.
+    pub fn set_owned_output(
+        &mut self,
+        width: u32,
+        height: u32,
+    ) -> Result<(), Box<dyn std::error::Error>> {
+        if width == 0
+            || height == 0
+            || width > self.device.limits().max_texture_dimension_2d
+            || height > self.device.limits().max_texture_dimension_2d
+        {
+            return Err("output dimensions exceed device limits or are zero".into());
+        }
+        let texture = self.device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("Nightshade external output"),
+            size: wgpu::Extent3d {
+                width,
+                height,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: self.surface_format,
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                | wgpu::TextureUsages::COPY_SRC
+                | wgpu::TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        });
+        self.set_external_output(texture)
+    }
+
+    /// The caller must allocate on this renderer's device. wgpu validates device identity.
+    /// Holding a cloned texture handle retains the resource through submitted GPU work.
+    pub fn set_external_output(
+        &mut self,
+        texture: wgpu::Texture,
+    ) -> Result<(), Box<dyn std::error::Error>> {
+        if self.surface.is_some() {
+            return Err("release the native surface before attaching an external output".into());
+        }
+        if texture.format() != self.surface_format
+            || texture.dimension() != wgpu::TextureDimension::D2
+            || texture.mip_level_count() != 1
+            || texture.sample_count() != 1
+            || texture.depth_or_array_layers() != 1
+            || !texture
+                .usage()
+                .contains(wgpu::TextureUsages::RENDER_ATTACHMENT)
+        {
+            return Err("incompatible external output".into());
+        }
+        self.resize_surface(texture.width(), texture.height())?;
+        let view = texture.create_view(&Default::default());
+        render_graph_set_external_texture(
+            &mut self.graph,
+            self.targets.swapchain,
+            Some(texture.clone()),
+            view,
+            texture.width(),
+            texture.height(),
+        );
+        self.external_output = Some(texture);
+        Ok(())
+    }
+}
