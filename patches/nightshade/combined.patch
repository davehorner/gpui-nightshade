+            &mut app.world,
+            ViewerAction::AddPrimitive(PrimitiveKind::Cube),
+        )
+        .unwrap();
+        for _ in 0..3 {
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+        }
+        let entity = snapshot(&app.world).nodes[0].entity;
+        for field in [
+            MaterialField::NormalScale(2.4), MaterialField::OcclusionStrength(0.45),
+            MaterialField::Dispersion(0.2), MaterialField::Clearcoat(0.85),
+            MaterialField::ClearcoatRoughness(0.3), MaterialField::SheenRoughness(0.4),
+            MaterialField::Iridescence(0.7), MaterialField::IridescenceIor(1.8),
+        ] {
