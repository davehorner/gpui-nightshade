diff --git a/crates/plugins/draw/nightshade-wgpu-geometry/src/shaders/browser_material.wgsl b/crates/plugins/draw/nightshade-wgpu-geometry/src/shaders/browser_material.wgsl
new file mode 100644
--- /dev/null
+++ b/crates/plugins/draw/nightshade-wgpu-geometry/src/shaders/browser_material.wgsl
@@ -0,0 +1,118 @@
+// Compact mobile material path. Keep the existing vertex, skinning/morph,
+// material and MRT ABIs; avoid the driver's monolithic advanced PBR fragment.
+#ifdef WEB_COMPAT
+#ifdef WEB_COMPAT_OIT
+@fragment
+fn fs_main(in: VertexOutput, @builtin(front_facing) front: bool) -> OITOutput
+#else
+@fragment
+fn fs_main(in: VertexOutput, @builtin(front_facing) front: bool) -> FragmentOutput
+#endif
+{
+    let filter_scale = select(0.0, 1.0, uniforms.material_filtering != 0u);
+    material_uv0_ddx = dpdx(in.tex_coords) * filter_scale;
+    material_uv0_ddy = dpdy(in.tex_coords) * filter_scale;
+    material_uv1_ddx = dpdx(in.tex_coords_1) * filter_scale;
+    material_uv1_ddy = dpdy(in.tex_coords_1) * filter_scale;
+#ifdef WEB_COMPAT_OIT
+    if in.flip_winding != 0u && front { discard; }
+#else
+    if (in.object_bits & 1u) != 0u && front { discard; }
+#endif
+    if uniforms.flat_color.a >= 2.0 { discard; }
+    let material = materials[in.material_id];
+    if material_reveal_distance(material, in.world_pos) > 0.0 { discard; }
+    let base_uv = texture_uv(in.tex_coords, in.tex_coords_1, material.base_transform, uniforms.time);
+    var tint = in.vertex_color;
+    var vertex_ao = 1.0;
+    if material.vertex_occlusion != 0u { vertex_ao = tint.r; tint = vec4<f32>(1.0, 1.0, 1.0, tint.a); }
+    var base = material.base_color * in.instance_tint * tint;
+    if material.base_layer != NO_LAYER {
+        base *= sample_atlas_srgb(material.base_layer, base_uv, in.tex_coords_1.x, material.atlas_cells, texture_uv_grad(material.base_transform));
+    }
+    if uniforms.flat_color.a > 0.0 { base = vec4<f32>(uniforms.flat_color.rgb, base.a); }
+    if material.alpha_mode == ALPHA_MODE_MASK && base.a < material.alpha_cutoff { discard; }
+#ifndef WEB_COMPAT_OIT
+    if material.alpha_mode == ALPHA_MODE_OPAQUE { base.a = 1.0; }
+    if material.alpha_mode == ALPHA_MODE_DITHER {
+        if base.a < interleaved_gradient_noise(in.position.xy) { discard; }
+        base.a = 1.0;
+    }
+#endif
+    var geometric_normal = select(-in.normal, in.normal, front);
+    let tangent = select(-in.world_tangent, in.world_tangent, front);
+    var normal_sample = vec3<f32>(0.5, 0.5, 1.0);
+    if material.normal_layer != NO_LAYER {
+        let uv = texture_uv(in.tex_coords, in.tex_coords_1, material.normal_transform, uniforms.time);
+        normal_sample = sample_linear_layer(material.normal_layer, uv, texture_uv_grad(material.normal_transform)).xyz;
+    }
+    let N = get_normal(geometric_normal, tangent, normal_sample, material.normal_layer != NO_LAYER, material.normal_scale, material.normal_map_flags);
+    var metallic = material.metallic;
+    var roughness = material.roughness;
+    if material.metallic_roughness_layer != NO_LAYER {
+        let uv = texture_uv(in.tex_coords, in.tex_coords_1, material.metallic_roughness_transform, uniforms.time);
+        let mr = sample_linear_layer(material.metallic_roughness_layer, uv, texture_uv_grad(material.metallic_roughness_transform));
+        roughness *= mr.g; metallic *= mr.b;
+    }
+    roughness = clamp(roughness, 0.08, 1.0); metallic = clamp(metallic, 0.0, 1.0);
+    var ao = vertex_ao;
+    if material.occlusion_layer != NO_LAYER {
+        let uv = texture_uv(in.tex_coords, in.tex_coords_1, material.occlusion_transform, uniforms.time);
+        ao *= mix(1.0, sample_linear_layer(material.occlusion_layer, uv, texture_uv_grad(material.occlusion_transform)).r, material.occlusion_strength);
+    }
+    var emission = material.emissive_factor * material.emissive_strength;
+    if material.emissive_layer != NO_LAYER {
+        let uv = texture_uv(in.tex_coords, in.tex_coords_1, material.emissive_transform, uniforms.time);
+        emission *= sample_srgb_layer(material.emissive_layer, uv, texture_uv_grad(material.emissive_transform)).rgb;
+    }
+    var color = base.rgb + emission;
+    if material.unlit == 0u && uniforms.global_unlit <= 0.5 && uniforms.flat_color.a <= 0.0 {
+        let V = normalize(uniforms.camera_position.xyz - in.world_pos);
+        let NdotV = max(dot(N, V), 0.001);
+        let F0 = mix(vec3<f32>(0.04), base.rgb, metallic);
+        let Fenv = fresnelSchlick(NdotV, F0);
+        let irradiance = textureSampleLevel(irradiance_map, irradiance_sampler, N, 0.0).rgb;
+        let reflected = textureSampleLevel(prefiltered_env, prefiltered_sampler, reflect(-V, N), roughness * 4.0).rgb;
+        let brdf = textureSampleLevel(brdf_lut, brdf_lut_sampler, vec2<f32>(NdotV, roughness), 0.0).rg;
+        color = ((vec3<f32>(1.0) - Fenv) * (1.0 - metallic) * base.rgb * irradiance + reflected * (F0 * brdf.x + brdf.y)) * ao;
+        for(var i = 0u; i < min(uniforms.num_lights.x, 8u); i++) {
+            let light = lights[i];
+            var direction = light.position.xyz - in.world_pos;
+            if light.light_type == LIGHT_TYPE_DIRECTIONAL { direction = -light.direction.xyz; }
+            let L = normalize(direction); let H = normalize(V + L);
+            let NdotL = max(dot(N, L), 0.0);
+            let F = fresnelSchlick(max(dot(H, V), 0.0), F0);
+            let specular = DistributionGGX(N, H, roughness) * V_SmithGGXCorrelated(NdotV, NdotL, roughness) * F;
+            let diffuse = (vec3<f32>(1.0) - F) * (1.0 - metallic) * base.rgb / PI;
+            color += (diffuse + specular) * getLightIntensity(light, direction, in.world_pos) * NdotL;
+        }
+        color += emission;
+    }
+    if uniforms.fog_enabled != 0u {
+        let depth = -(uniforms.view * vec4<f32>(in.world_pos, 1.0)).z;
+        color = mix(color, uniforms.fog_color, clamp((depth - uniforms.fog_start) / max(uniforms.fog_end - uniforms.fog_start, 0.001), 0.0, 1.0));
+    }
+    color = clamp(select(vec3<f32>(0.0), color, color == color), vec3<f32>(0.0), vec3<f32>(65000.0));
+    let cur = uniforms.cur_view_projection * vec4<f32>(in.world_pos, 1.0);
+    let prev = uniforms.prev_view_projection * vec4<f32>(in.prev_world_pos, 1.0);
+    let velocity = (prev.xy / prev.w - cur.xy / cur.w) * vec2<f32>(0.5, -0.5);
+#ifdef WEB_COMPAT_OIT
+    var out: OITOutput;
+    let alpha = clamp(base.a, 0.0, 1.0);
+#ifdef WEBGPU_PERSPECTIVE
+    let screen_linear_depth = in.view_depth * in.position.w;
+#else
+    let screen_linear_depth = in.view_depth;
+#endif
+    out.accum = vec4<f32>(color, 1.0) * weight(screen_linear_depth, alpha);
+    out.reveal = 1.0 - alpha;
+#else
+    var out: FragmentOutput;
+    out.color = vec4<f32>(color, base.a);
+    out.view_normal = vec4<f32>(normalize(in.view_normal), metallic);
+#endif
+    out.entity_id = bitcast<f32>(in.entity_id);
+    out.velocity = velocity;
+    return out;
+}
+#endif
