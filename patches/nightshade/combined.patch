+        app.stages.run(&mut app.world);
+        app.world.res_mut::<crate::resources::ViewerResources>().history = Default::default();
+        let (sender, receiver) = mpsc::channel();
+        let client = std::thread::spawn(move || {
+            let scene = call(port, "get_scene", json!({}));
+            assert!(
+                scene["nodes"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .any(|node| node["entity"] == entity.id)
+            );
+            assert_eq!(
+                call(port, "get_camera_views", json!({}))["supported"],
+                false
+            );
+            for (name, args) in [
+                ("set_camera_views", json!({"count":4})),
+                ("focus_camera_view", json!({"index":0})),
+                ("set_view_camera", json!({"index":0,"entity":entity.id})),
+                ("get_camera_views", json!({"typo":true})),
+                (
+                    "set_camera_views",
+                    json!({"count":4,"active":null,"typo":true}),
+                ),
+            ] {
+                assert_eq!(raw_call(port, name, args)["isError"], true);
+            }
+            let edit = call(port, "set_render", json!({"exposure":2.5}));
+            assert_eq!(edit["queued"], true);
+            assert_eq!(edit["operation_status"], "queued");
+            let deadline = Instant::now() + Duration::from_secs(3);
+            let applied = loop {
+                let operation = call(
+                    port,
+                    "get_operation",
+                    json!({"operation_id":edit["operation_id"]}),
+                );
+                if operation["status"] == "applied" {
+                    break operation;
+                }
+                assert_ne!(operation["status"], "failed", "{operation}");
+                assert!(Instant::now() < deadline, "{operation}");
+                std::thread::sleep(Duration::from_millis(1));
+            };
+            assert_eq!(applied["result"]["exposure"], 2.5);
+            assert_eq!(applied["completion_boundary"], "scene_actions_applied");
+            call(port, "set_render", json!({"exposure":1.0}));
+            assert_eq!(
+                call(
+                    port,
+                    "get_operation",
+                    json!({"operation_id":edit["operation_id"]})
+                ),
+                applied,
+                "operation results are retained snapshots, not later live state"
+            );
+            for args in [
+                json!({"operation_id":"unknown"}),
+                json!({}),
+                json!({"operation_id":edit["operation_id"],"typo":true}),
+            ] {
+                assert_eq!(raw_call(port, "get_operation", args)["isError"], true);
+            }
+            call(port, "select_entity", json!({"entity":entity.id}));
+            call(
+                port,
+                "rename_entity",
+                json!({"entity":entity.id,"name":"From MCP"}),
+            );
+            call(
+                port,
+                "set_transform",
+                json!({"entity":entity.id,"translation":[5.,2.,1.]}),
+            );
+            let edited = call(port, "get_transform", json!({"entity":entity.id}));
+            assert_eq!(edited["translation"], json!([5., 2., 1.]));
+            call(port, "undo", json!({}));
+            let undone = call(port, "get_transform", json!({"entity":entity.id}));
+            assert_ne!(undone["translation"], edited["translation"]);
+            call(port, "redo", json!({}));
+            let transform = call(port, "get_transform", json!({"entity":entity.id}));
+            for (name, args) in [
+                ("get_transform", json!({"entity":entity.id,"typo":true})),
+                (
+                    "set_transform",
+                    json!({"entity":entity.id,"scale":[1e100,1,1]}),
+                ),
+                ("play_clip", json!({"index":99999})),
+                (
+                    "set_animation_layer_weight",
+                    json!({"index":0,"weight":0.5}),
+                ),
+                ("get_morph_weights", json!({"entity":entity.id})),
+                ("undo", json!({"typo":true})),
+            ] {
+                assert_eq!(raw_call(port, name, args)["isError"], true, "{name}");
+            }
+            let before_batch = call(port, "get_transform", json!({"entity":entity.id}));
+            for transforms in [
+                json!([]),
+                json!([{"entity":entity.id,"translation":[99,99,99]},{"entity":4294967295u32}]),
+                json!([{"entity":entity.id},{"entity":entity.id}]),
+                json!([{"entity":entity.id,"translation":[99,99,99]},{"entity":entity.id,"scale":[1e100,1,1]}]),
+            ] {
+                assert_eq!(
+                    raw_call(port, "set_transforms", json!({"transforms":transforms}))["isError"],
+                    true
+                );
+                assert_eq!(
+                    call(port, "get_transform", json!({"entity":entity.id})),
+                    before_batch
+                );
+            }
+            let batch = call(
+                port,
+                "set_transforms",
+                json!({"transforms":[{"entity":entity.id,"translation":[5,2,1]}]}),
+            );
+            assert_eq!(batch["transforms"][0], before_batch);
+            let material = call(port, "get_material", json!({"entity":entity.id}));
+            for (field, expected) in [
+                ("normal_scale", 2.4), ("occlusion_strength", 0.45),
+                ("dispersion", 0.2), ("clearcoat", 0.85), ("clearcoat_roughness", 0.3),
+                ("sheen_roughness", 0.4), ("iridescence", 0.7), ("iridescence_ior", 1.8),
+            ] {
+                assert!((material[field].as_f64().unwrap()-expected).abs() < 1e-6, "{field}: {material}");
+            }
+            let changed = call(
+                port,
+                "set_material",
+                json!({"entity":entity.id,"roughness":0.27,"metallic":0.42}),
+            );
+            assert!((changed["roughness"].as_f64().unwrap() - 0.27).abs() < 1e-6);
+            call(port, "undo", json!({}));
+            assert_eq!(
+                call(port, "get_material", json!({"entity":entity.id})),
+                material
+            );
+            call(port, "redo", json!({}));
+            assert_eq!(
+                call(port, "get_material", json!({"entity":entity.id})),
+                changed
+            );
+            call(port, "add_light", json!({"kind":"spot"}));
+            let light = call(port, "get_selection", json!({}))["entity"].clone();
+            let before = call(port, "get_light", json!({"entity":light}));
+            call(port, "select_entity", json!({"entity":entity.id}));
+            let changed = call(
+                port,
+                "set_light",
+                json!({"entity":light,"intensity":42.0,"color":[0.2,0.4,0.8]}),
+            );
+            assert_eq!(changed["intensity"], 42.0);
+            assert_eq!(call(port, "get_selection", json!({}))["entity"], entity.id);
+            call(port, "undo", json!({}));
+            assert_eq!(call(port, "get_light", json!({"entity":light})), before);
+            call(port, "redo", json!({}));
+            assert_eq!(call(port, "get_light", json!({"entity":light})), changed);
+            let cube_before = call(port, "get_transform", json!({"entity":entity.id}));
+            let light_before = call(port, "get_transform", json!({"entity":light}));
+            let batch = call(
+                port,
+                "set_transforms",
+                json!({"transforms":[
+                    {"entity":entity.id,"translation":[7,4,2]},
+                    {"entity":light,"translation":[1,8,3]}
+                ]}),
+            );
+            assert_eq!(batch["transforms"].as_array().unwrap().len(), 2);
+            call(port, "undo", json!({}));
+            assert_eq!(
+                call(port, "get_transform", json!({"entity":entity.id})),
+                cube_before
+            );
+            assert_eq!(
+                call(port, "get_transform", json!({"entity":light})),
+                light_before
+            );
+            call(port, "redo", json!({}));
+            assert_eq!(
+                call(port, "get_transform", json!({"entity":entity.id})),
+                batch["transforms"][0]
+            );
+            assert_eq!(
+                call(port, "get_transform", json!({"entity":light})),
+                batch["transforms"][1]
+            );
+            call(port, "set_animation", json!({"blend_time":0.7}));
+            let animation = call(port, "get_animation", json!({}));
+            assert!((animation["blend_time"].as_f64().unwrap() - 0.7).abs() < 1e-6);
+            sender.send(transform).unwrap();
+        });
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let result = loop {
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+            if let Ok(result) = receiver.try_recv() {
+                break result;
+            }
+            assert!(Instant::now() < deadline, "MCP client did not complete");
+            std::thread::sleep(Duration::from_millis(1));
+        };
+        client.join().unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        let state = snapshot(&app.world);
+        assert_eq!(result["translation"], json!([5., 2., 1.]));
+        assert_eq!(state.selection.name, "From MCP");
+        assert_eq!(state.selection.translation, [7., 4., 2.]);
+        assert!(
+            !app.world
+                .resources
+                .contains::<nightshade_ui::resources::RetainedUiRuntime>()
+        );
+        let mut crew = app
+            .world
+            .res::<crate::resources::ViewerResources>()
+            .incoming
+            .crew
+            .clone();
+        crate::commands::crew::wait_for_the_crew(&mut crew);
