+//! Frontend-neutral access to the trunk viewer dispatcher and owned state snapshots.
+#[cfg(not(target_arch = "wasm32"))]
+pub use crate::camera_views::finish_camera_view_request;
+pub use crate::camera_views::{
+    CameraTile, CameraViewCommand, CameraViewRequest, CameraViews, camera_views,
+    publish_camera_views, take_camera_view_requests,
+};
+pub use crate::data::*;
+pub use crate::plugin::ViewerCorePlugin;
+pub use crate::resources::{
+    AnimationView, BrowserEntry, ClipInfo, LayerView, MaterialView, ModelStats, MorphInfo,
+    SceneRow, Selection, ViewerArguments,
+};
+pub use nightshade::prelude::Entity as SceneEntity;
+use nightshade::prelude::*;
+
+#[derive(Default)]
+pub struct FrontendInput {
+    pub pointer_over_ui: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BrowserStatus {
+    Idle,
+    Loading,
+    Ready,
+    Failed,
+}
+#[derive(Clone)]
+pub struct BrowserSnapshot {
+    pub tab: BrowserTab,
+    pub query: String,
+    pub page: usize,
+    pub pages: usize,
+    pub status: BrowserStatus,
+    pub entries: Vec<BrowserEntry>,
+    pub resolution: u32,
+}
+fn browser_snapshot(viewer: &crate::resources::ViewerResources) -> Option<BrowserSnapshot> {
+    use crate::{
+        queries::browsers::{page_count, page_entries},
+        resources::FetchState,
+    };
+    fn status<T>(state: &std::sync::Mutex<FetchState<T>>) -> BrowserStatus {
+        state
+            .lock()
+            .map_or(BrowserStatus::Failed, |state| match &*state {
+                FetchState::Idle => BrowserStatus::Idle,
+                FetchState::Loading => BrowserStatus::Loading,
+                FetchState::Loaded(_) => BrowserStatus::Ready,
+                FetchState::Failed => BrowserStatus::Failed,
+            })
+    }
+    let tab = viewer.view.browser?;
+    let query = viewer.view.search.to_lowercase();
+    let pages = page_count(viewer, tab, &query);
+    let page = viewer.view.browser_page.min(pages - 1);
+    Some(BrowserSnapshot {
+        tab,
+        query: viewer.view.search.clone(),
+        page,
+        pages,
+        resolution: viewer.view.resolution,
+        status: match tab {
+            BrowserTab::Library => {
+                if viewer.library.scanning {
+                    BrowserStatus::Loading
+                } else {
+                    BrowserStatus::Ready
+                }
+            }
+            BrowserTab::Khronos => status(&viewer.browsers.khronos),
+            BrowserTab::Models => status(&viewer.browsers.models),
+            BrowserTab::Skies => status(&viewer.browsers.skies),
+        },
+        entries: page_entries(viewer, tab, &query, page),
+    })
+}
+
+#[derive(Clone, Copy)]
+pub struct RenderingControls {
+    pub shading: usize,
+    pub pbr_debug: usize,
+    pub tonemap: usize,
+    pub atmosphere: usize,
+    pub anti_aliasing: usize,
+    pub hdr_loaded: bool,
+    pub show_normals: bool,
+    pub show_bounds: bool,
+    pub fog_start: f32,
+    pub fog_end: f32,
+    pub fog_color: [f32; 3],
+    pub sun_intensity: f32,
+    pub sun_yaw: f32,
+    pub sun_pitch: f32,
+    pub sun_shadows: bool,
+}
+#[derive(Clone, Copy)]
+pub struct GizmoSnapshot {
+    pub enabled: bool,
+    pub mode: GizmoMode,
+    pub snap: bool,
+    pub dragging: bool,
+}
+/// An owned snapshot; no ECS guards, UI entities or mutable resource references escape.
+#[derive(Clone)]
+pub struct ViewerSnapshot {
+    pub gizmo: GizmoSnapshot,
+    pub render: RenderingControls,
+    pub browser: Option<BrowserSnapshot>,
+    pub nodes: Vec<SceneRow>,
+    pub selection: Selection,
+    pub animation: AnimationView,
+    pub clips: Vec<ClipInfo>,
+    pub animation_root: Option<SceneEntity>,
+    pub morphs: Vec<MorphInfo>,
+    pub skeleton_enabled: bool,
+    pub joint_count: usize,
+    pub has_held_clips: bool,
+    pub stats: Option<ModelStats>,
+    pub loading: bool,
+    pub grid: bool,
+    pub notice: Option<String>,
+    pub settings: nightshade_render::data::config::RenderSettings,
+    pub can_undo: bool,
+    pub can_redo: bool,
+}
+pub const ACTION_QUEUE_CAPACITY: usize = 4096;
+pub fn submit(world: &mut World, action: ViewerAction) -> Result<(), ViewerAction> {
+    let viewer = world.res_mut::<crate::resources::ViewerResources>();
+    if viewer.actions.len() >= ACTION_QUEUE_CAPACITY {
+        return Err(action);
+    }
+    viewer.actions.push(action);
+    Ok(())
+}
+pub fn snapshot(world: &World) -> ViewerSnapshot {
+    let viewer = world.res::<crate::resources::ViewerResources>();
+    ViewerSnapshot {
+        gizmo: GizmoSnapshot {
+            enabled: viewer.gizmo.enabled,
+            mode: viewer.gizmo.mode,
+            snap: viewer.view.snap,
+            dragging: viewer.gizmo.drag.is_some(),
+        },
+        render: RenderingControls {
+            shading: viewer.view.shading,
+            pbr_debug: viewer.view.pbr_debug,
+            tonemap: viewer.view.tonemap,
+            atmosphere: viewer.view.atmosphere,
+            anti_aliasing: viewer.view.anti_aliasing,
+            hdr_loaded: viewer.view.hdr_loaded,
+            show_normals: viewer.view.show_normals,
+            show_bounds: viewer.view.show_bounds,
+            fog_start: viewer.view.fog_start,
+            fog_end: viewer.view.fog_end,
+            fog_color: viewer.view.fog_color,
+            sun_intensity: viewer.sun.intensity,
+            sun_yaw: viewer.sun.yaw,
+            sun_pitch: viewer.sun.pitch,
+            sun_shadows: viewer.sun.shadows,
+        },
+        browser: browser_snapshot(viewer),
+        nodes: viewer.model.rows.clone(),
+        selection: viewer.selection.clone(),
+        animation: viewer.animation.clone(),
+        clips: viewer.model.clips.clone(),
+        animation_root: viewer.model.roots.first().copied(),
+        morphs: viewer
+            .model
+            .morphs
+            .iter()
+            .filter(|info| world.storage.is_alive(info.entity))
+            .map(|info| {
+                let mut info = info.clone();
+                if let Some(weights) =
+                    world
+                        .storage
+                        .get::<nightshade_render::components::morph::MorphWeights>(info.entity)
+                {
+                    info.weights = weights.weights.clone();
+                }
+                info
+            })
+            .collect(),
+        skeleton_enabled: viewer.skeleton.enabled,
+        joint_count: viewer
+            .model
+            .entities
+            .iter()
+            .filter_map(|entity| {
+                world
+                    .storage
+                    .get::<nightshade_render::components::skin::Skin>(*entity)
+            })
+            .flat_map(|skin| skin.joints.iter().copied())
+            .collect::<std::collections::HashSet<_>>()
+            .len(),
+        has_held_clips: viewer.model.held_clips.is_some(),
+        stats: viewer.model.stats.clone(),
+        loading: viewer.model.pending.is_some()
+            || viewer
+                .incoming
+                .loading
+                .lock()
+                .ok()
+                .is_some_and(|loading| loading.is_some()),
+        grid: viewer.view.grid,
+        notice: viewer
+            .incoming
+            .notice
+            .lock()
+            .ok()
+            .and_then(|notice| notice.clone()),
+        settings: world
+            .res::<nightshade_render::data::config::RenderSettings>()
+            .clone(),
+        can_undo: !viewer.history.done.is_empty(),
+        can_redo: !viewer.history.undone.is_empty(),
+    }
+}
+/// Compose the original scene/plugin stack with caller-owned arguments and no native UI or event loop.
+pub fn compose(arguments: ViewerArguments, plugin: ViewerCorePlugin) -> App {
+    let mut app = nightshade_app::commands::compose_embedded(
+        nightshade_app::Opening::titled("Viewer"),
+        arguments,
+    );
+    app.add_plugin(nightshade_text::TextPlugin)
+        .add_plugin(nightshade_animation::AnimationPlugin)
+        .add_plugin(nightshade_camera_controller::CameraControllerPlugin)
+        .add_plugin(nightshade_gltf::GltfPlugin)
+        .add_plugin(plugin);
+    app
+}
+
+pub(crate) fn advance_history(mut viewer: ResMut<crate::resources::ViewerResources>) {
+    viewer.history.frame += 1;
+}
+
+/// The persistent navigation camera owned by the viewer, independent of imported models.
+pub fn editor_camera(world: &World) -> Option<Entity> {
+    world
+        .res::<crate::resources::ViewerResources>()
+        .camera_input
+        .viewer_camera
+}
+
+/// Include a frontend-owned camera in the existing camera snapshot and MCP catalogue.
+/// Camera entities remain owned by the caller and are not exported with model roots.
+pub fn register_frontend_camera(world: &mut World, entity: Entity, name: String) -> bool {
+    if !world
+        .storage
+        .has::<nightshade_camera::components::Camera>(entity)
+    {
+        return false;
+    }
+    let viewer = world.res_mut::<crate::resources::ViewerResources>();
+    if !viewer.model.cameras.iter().any(|(held, _)| *held == entity) {
+        viewer.model.cameras.push((entity, name));
+    }
+    true
+}
+
+pub fn request_pick(world: &mut World, x: u32, y: u32) {
+    let viewer = world.res_mut::<crate::resources::ViewerResources>();
+    viewer.picking.click_wanted = Some(nightshade::prelude::nalgebra_glm::vec2(x as f32, y as f32));
+    viewer.picking.click_adds = false;
+}
+pub fn pick_pending(world: &World) -> bool {
+    let viewer = world.res::<crate::resources::ViewerResources>();
+    viewer.picking.click_wanted.is_some() || viewer.picking.outstanding.is_some()
+}
+
+/// Revert an unfinished gizmo gesture without adding an undo entry.
+pub fn cancel_pointer_gesture(world: &mut World) {
+    let viewer = world
+        .resources
+        .res_mut::<crate::resources::ViewerResources>();
+    viewer.picking.last_press = None;
+    viewer.picking.click_wanted = None;
+    viewer.gizmo.hovered = None;
+    if let Some(drag) = viewer.gizmo.drag.take() {
+        for start in drag.starts {
+            crate::commands::selection::restore_transform(
+                &mut world.storage,
+                start.entity,
+                &start.transform,
+            );
+        }
+    }
+}
+
