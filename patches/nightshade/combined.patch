diff --git a/apps/viewer/src/operations.rs b/apps/viewer/src/operations.rs
new file mode 100644
index 0000000..1b69047
--- /dev/null
+++ b/apps/viewer/src/operations.rs
@@ -0,0 +1,133 @@
+use serde_json::{Value, json};
+use std::collections::VecDeque;
+
+const CAPACITY: usize = 256;
+
+#[derive(Default)]
+pub(crate) struct Operations {
+    entries: VecDeque<Operation>,
+}
+
+struct Operation {
+    id: String,
+    tool: String,
+    target: Option<u32>,
+    status: &'static str,
+    submitted_tick: u64,
+    finished_tick: Option<u64>,
+    result: Option<Value>,
+    error: Option<String>,
+}
+
+impl Operations {
+    pub fn reserve(
+        &mut self,
+        tool: &str,
+        tick: u64,
+        target: Option<u32>,
+    ) -> Result<String, String> {
+        if self.entries.len() == CAPACITY {
+            let index = self
+                .entries
+                .iter()
+                .position(|o| matches!(o.status, "applied" | "failed"))
+                .ok_or("the operation tracker is full; pending operations are retained")?;
+            self.entries.remove(index);
+        }
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        let sequence = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let epoch = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_nanos();
+        let id = format!("op-{epoch:x}-{sequence:x}");
+        self.entries.push_back(Operation {
+            id: id.clone(),
+            tool: tool.into(),
+            target,
+            status: "queued",
+            submitted_tick: tick,
+            finished_tick: None,
+            result: None,
+            error: None,
+        });
+        Ok(id)
+    }
+
+    pub fn discard(&mut self, id: &str) {
+        self.entries.retain(|o| o.id != id);
+    }
+
+    pub fn dispatched(&mut self, id: &str) {
+        if let Some(o) = self.entries.iter_mut().find(|o| o.id == id) {
+            o.status = "dispatched";
+        }
+    }
+
+    pub fn ready(&self) -> Vec<(String, String, Option<u32>)> {
+        self.entries
+            .iter()
+            .filter(|o| o.status == "dispatched")
+            .map(|o| (o.id.clone(), o.tool.clone(), o.target))
+            .collect()
+    }
+
+    pub fn finish(&mut self, id: &str, tick: u64, result: Result<Value, String>) {
+        if let Some(o) = self.entries.iter_mut().find(|o| o.id == id) {
+            o.finished_tick = Some(tick);
+            match result {
+                Ok(result) => {
+                    o.status = "applied";
+                    o.result = Some(if result.to_string().len() <= 65536 {
+                        result
+                    } else {
+                        json!({"state_omitted":true,"reason":"post-edit state exceeds 64 KiB; query the scene directly"})
+                    });
+                }
+                Err(error) => {
+                    o.status = "failed";
+                    o.error = Some(error);
+                }
+            }
+        }
+    }
+
+    pub fn get(&self, id: &str) -> Result<Value, String> {
+        let o = self
+            .entries
+            .iter()
+            .find(|o| o.id == id)
+            .ok_or("unknown or expired operation ID")?;
+        Ok(
+            json!({"operation_id":o.id, "tool":o.tool, "status":o.status,
+            "submitted_tick":o.submitted_tick, "finished_tick":o.finished_tick,
+            "result":o.result, "error":o.error,
+            "completion_boundary":"scene_actions_applied"}),
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn pending_records_are_bounded_and_never_evicted() {
+        let mut ops = Operations::default();
+        let first = ops.reserve("set_render", 0, None).unwrap();
+        for _ in 1..CAPACITY {
+            ops.reserve("set_render", 0, None).unwrap();
+        }
+        assert!(ops.reserve("set_render", 1, None).is_err());
+        assert_eq!(ops.get(&first).unwrap()["status"], "queued");
+        ops.finish(&first, 1, Err("target disappeared".into()));
+        let next = ops.reserve("set_render", 2, None).unwrap();
+        assert!(ops.get(&first).is_err());
+        assert_ne!(first, next);
+        ops.dispatched(&next);
+        assert_eq!(ops.ready(), vec![(next.clone(), "set_render".into(), None)]);
+        ops.finish(&next, 3, Ok(json!({"exposure":2.})));
+        let value = ops.get(&next).unwrap();
+        assert_eq!(value["status"], "applied");
+        assert_eq!(value["result"]["exposure"], 2.);
+    }
+}
