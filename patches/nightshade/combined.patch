+    #[test]
+    fn browser_snapshots_filter_clamp_and_own_catalog_entries() {
+        use crate::resources::{FetchState, PolyAsset, ViewerResources};
+        let mut app = compose(
+            ViewerArguments {
+                no_agent: true,
+                preview: true,
+                ..Default::default()
+            },
+            ViewerCorePlugin {
+                persist_settings: false,
+                remote_catalogs: false,
+            },
+        );
+        app.stages.apply_orderings();
+        app.startup.run(&mut app.world);
+        {
+            let viewer = app.world.res_mut::<ViewerResources>();
+            *viewer.browsers.models.lock().unwrap() = FetchState::Loaded(
+                (0..125)
+                    .map(|i| PolyAsset {
+                        slug: format!("asset_{i}"),
+                        name: format!("Model {i:03}"),
+                        thumbnail: String::new(),
+                    })
+                    .collect(),
+            );
+        }
+        submit(
+            &mut app.world,
+            ViewerAction::OpenBrowser(BrowserTab::Models),
+        )
+        .unwrap();
+        submit(&mut app.world, ViewerAction::SetBrowserPage(usize::MAX)).unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        let page = snapshot(&app.world).browser.unwrap();
+        assert_eq!(page.status, BrowserStatus::Ready);
+        assert_eq!((page.page, page.pages, page.entries.len()), (2, 3, 5));
+        submit(
+            &mut app.world,
+            ViewerAction::SetBrowserSearch("MODEL 001".into()),
+        )
+        .unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        let filtered = snapshot(&app.world).browser.unwrap();
+        assert_eq!(
+            (filtered.page, filtered.pages, filtered.entries.len()),
+            (0, 1, 1)
+        );
+        assert!(matches!(&filtered.entries[0].item,BrowserItem::Model(slug) if slug=="asset_1"));
+        {
+            let viewer = app.world.res_mut::<ViewerResources>();
+            *viewer.browsers.models.lock().unwrap() = FetchState::Failed;
+        }
+        let failed = snapshot(&app.world).browser.unwrap();
+        assert_eq!(failed.status, BrowserStatus::Failed);
+        assert!(failed.entries.is_empty());
+        assert_eq!(
+            filtered.entries[0].label, "Model 001",
+            "snapshots own catalog data"
+        );
+        submit(&mut app.world, ViewerAction::CloseBrowser).unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        assert!(snapshot(&app.world).browser.is_none());
+    }
