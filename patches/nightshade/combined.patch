+    #[test]
+    fn animation_layers_morph_weights_and_skeleton_work_without_ui() {
+        use crate::resources::ViewerResources;
+        use nightshade_animation::contract::{AnimationClip, AnimationPlayer};
+        use nightshade_render::components::{morph::MorphWeights, skin::Skin};
+        let mut app = compose(
+            ViewerArguments {
+                no_agent: true,
+                preview: true,
+                ..Default::default()
+            },
+            ViewerCorePlugin {
+                persist_settings: false,
+                remote_catalogs: false,
+            },
+        );
+        app.stages.apply_orderings();
+        app.startup.run(&mut app.world);
+        let joint = app
+            .world
+            .spawn((nightshade_scene::contract::GlobalTransform::default(),));
+        let root = app.world.spawn((AnimationPlayer {
+            clips: vec![AnimationClip {
+                name: "Test clip".into(),
+                duration: 2.,
+                ..Default::default()
+            }],
+            ..Default::default()
+        },));
+        let mesh = app.world.spawn((
+            MorphWeights::new(vec![0., 0.], "Morph mesh"),
+            Skin::new(vec![joint], vec![nalgebra_glm::Mat4::identity()]),
+        ));
+        {
+            let viewer = app.world.res_mut::<ViewerResources>();
+            viewer.model.roots = vec![root];
+            viewer.model.entities = vec![root, mesh, joint];
+            viewer.model.clips = vec![ClipInfo {
+                name: "Test clip".into(),
+                duration: 2.,
+            }];
+            viewer.model.morphs = vec![MorphInfo {
+                entity: mesh,
+                name: "Morph mesh".into(),
+                weights: vec![0., 0.],
+            }];
+        }
+        submit(&mut app.world, ViewerAction::SetBlendTime(0.4)).unwrap();
+        submit(&mut app.world, ViewerAction::TogglePlayback).unwrap();
+        submit(
+            &mut app.world,
+            ViewerAction::AddAnimationLayer {
+                clip: 0,
+                weight: 0.5,
+            },
+        )
+        .unwrap();
+        submit(&mut app.world, ViewerAction::SetShowSkeleton(true)).unwrap();
+        for _ in 0..3 {
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+        }
+        let initial = snapshot(&app.world);
+        assert_eq!(initial.animation_root, Some(root));
+        assert_eq!(initial.animation.blend_time, 0.4);
+        assert!(initial.animation.playing);
+        assert_eq!(initial.animation.clip, Some(0));
+        assert_eq!(initial.animation.layers.len(), 1);
+        assert_eq!(initial.animation.layers[0].weight, 0.5);
+        assert!(initial.skeleton_enabled);
+        for playing in [false, false, true, true] {
+            submit(&mut app.world, ViewerAction::SetPlayback(playing)).unwrap();
+            app.world.increment_tick();
+            app.stages.run(&mut app.world);
+            assert_eq!(snapshot(&app.world).animation.playing, playing);
+        }
+
+        assert_eq!(initial.joint_count, 1);
+        submit(
+            &mut app.world,
+            ViewerAction::SetLayerWeight {
+                index: 0,
+                weight: 0.25,
+            },
+        )
+        .unwrap();
+        submit(
+            &mut app.world,
+            ViewerAction::SetMorphWeight {
+                entity: mesh,
+                index: 1,
+                weight: 0.8,
+            },
+        )
+        .unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        app.world
+            .storage
+            .get_mut::<MorphWeights>(mesh)
+            .unwrap()
+            .set_weight(0, 0.7);
+        let edited = snapshot(&app.world);
+        assert_eq!(edited.animation.layers[0].weight, 0.25);
+        assert_eq!(
+            edited.morphs[0].weights,
+            vec![0.7, 0.8],
+            "snapshots read current ECS morph weights"
+        );
+        assert_eq!(
+            initial.morphs[0].weights,
+            vec![0., 0.],
+            "snapshots own their weights"
+        );
+        submit(&mut app.world, ViewerAction::RemoveAnimationLayer(0)).unwrap();
+        submit(&mut app.world, ViewerAction::StopAnimation).unwrap();
+        submit(&mut app.world, ViewerAction::SetShowSkeleton(false)).unwrap();
+        app.world.increment_tick();
+        app.stages.run(&mut app.world);
+        let stopped = snapshot(&app.world);
+        assert!(stopped.animation.layers.is_empty());
+        assert!(!stopped.animation.playing);
+        assert!(!stopped.skeleton_enabled);
+        assert!(
+            !app.world
+                .resources
+                .contains::<nightshade_ui::resources::RetainedUiRuntime>()
+        );
+    }
