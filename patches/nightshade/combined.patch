 #[cfg(not(target_arch = "wasm32"))]
 pub async fn drain_queued_work(_queue: &wgpu::Queue) {}
+
+// Persist the last renderer checkpoint outside WASM, even if a browser process dies.
+#[cfg(target_arch = "wasm32")]
+#[wasm_bindgen::prelude::wasm_bindgen(inline_js = "export function rendererCheckpoint(stage,message,memory) { window.dispatchEvent(new CustomEvent('nightshade-stage',{detail:{stage,message,wasmMemoryBytes:memory.buffer.byteLength}})); } export function compactMaterials() { const p=new URLSearchParams(location.search); const mode=p.get('materials'); return mode==='compact'||(mode!=='full'&&(/Android|iPhone|iPad|Mobile/i.test(navigator.userAgent)||p.has('safe'))); }")]
+extern "C" {
+    #[wasm_bindgen::prelude::wasm_bindgen(js_name=compactMaterials)]
+    fn compact_materials() -> bool;
+    #[wasm_bindgen::prelude::wasm_bindgen(js_name=rendererCheckpoint)]
+    fn renderer_checkpoint(stage: &str, message: &str, memory: wasm_bindgen::JsValue);
+}
+
+pub fn checkpoint(message: &str) {
+    #[cfg(target_arch = "wasm32")]
+    renderer_checkpoint("starting", message, wasm_bindgen::memory());
+    #[cfg(not(target_arch = "wasm32"))]
+    let _ = message;
+}
+
+pub fn report_error(message: &str) {
+    #[cfg(target_arch = "wasm32")]
+    renderer_checkpoint("error", message, wasm_bindgen::memory());
+    #[cfg(not(target_arch = "wasm32"))]
+    let _ = message;
+}
+
+pub fn use_compact_materials() -> bool {
+    #[cfg(target_arch = "wasm32")]
+    { compact_materials() }
+    #[cfg(not(target_arch = "wasm32"))]
+    { false }
+}
