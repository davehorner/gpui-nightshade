diff --git a/apps/viewer/src/camera_views.rs b/apps/viewer/src/camera_views.rs
new file mode 100644
index 0000000..0f07841
--- /dev/null
+++ b/apps/viewer/src/camera_views.rs
@@ -0,0 +1,113 @@
+//! Frontend-owned camera tiles exposed through the existing viewer endpoint.
+use nightshade::{World, ecs::Entity};
+use serde_json::{Value, json};
+
+#[derive(Clone, Debug)]
+pub struct CameraTile {
+    pub index: usize,
+    pub camera: Entity,
+    /// Physical output pixels: x, y, width, height.
+    pub rect: [u32; 4],
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct CameraViews {
+    pub supported: bool,
+    pub count: u32,
+    pub active: usize,
+    pub width: u32,
+    pub height: u32,
+    pub tiles: Vec<CameraTile>,
+}
+
+#[derive(Clone, Debug)]
+pub enum CameraViewCommand {
+    Layout {
+        count: u32,
+        active: Option<usize>,
+    },
+    Focus {
+        index: usize,
+    },
+    Assign {
+        index: usize,
+        camera: Option<Entity>,
+    },
+}
+
+pub struct CameraViewRequest {
+    pub operation_id: String,
+    pub command: CameraViewCommand,
+}
+
+pub(crate) fn state(views: &CameraViews) -> Value {
+    json!({"supported":views.supported, "count":views.count, "active":views.active,
+        "width":views.width, "height":views.height,
+        "tiles":views.tiles.iter().map(|t| json!({"index":t.index,"camera":t.camera.id,
+            "rect":{"x":t.rect[0],"y":t.rect[1],"width":t.rect[2],"height":t.rect[3]}})).collect::<Vec<_>>()})
+}
+
+pub fn publish_camera_views(world: &mut World, views: CameraViews) {
+    world
+        .res_mut::<crate::resources::ViewerResources>()
+        .camera_views = views;
+}
+
+pub fn camera_views(world: &World) -> CameraViews {
+    world
+        .res::<crate::resources::ViewerResources>()
+        .camera_views
+        .clone()
+}
+
+pub fn take_camera_view_requests(world: &mut World) -> Vec<CameraViewRequest> {
+    std::mem::take(
+        &mut world
+            .res_mut::<crate::resources::ViewerResources>()
+            .camera_view_requests,
+    )
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn enqueue(
+    viewer: &mut crate::resources::ViewerResources,
+    command: CameraViewCommand,
+    tool: &str,
+) -> Result<Value, String> {
+    if !viewer.camera_views.supported {
+        return Err("this frontend does not support shared camera tiles".into());
+    }
+    match command {
+        CameraViewCommand::Layout { count, active } => {
+            if !matches!(count, 1 | 2 | 4) {
+                return Err("camera count must be 1, 2 or 4".into());
+            }
+            if active.is_some_and(|i| i >= count as usize) {
+                return Err("active tile is outside the requested layout".into());
+            }
+        }
+        CameraViewCommand::Focus { index } | CameraViewCommand::Assign { index, .. } => {
+            if index >= viewer.camera_views.tiles.len() {
+                return Err("there is no visible tile at that index".into());
+            }
+        }
+    }
+    if viewer.camera_view_requests.len() >= 128 {
+        return Err("the camera view request queue is full".into());
+    }
+    let id = viewer
+        .operations
+        .reserve(tool, viewer.history.frame, None)?;
+    viewer.camera_view_requests.push(CameraViewRequest {
+        operation_id: id.clone(),
+        command,
+    });
+    Ok(json!({"queued":true,"operation_id":id,"operation_status":"queued"}))
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub fn finish_camera_view_request(world: &mut World, id: &str, result: Result<(), String>) {
+    let viewer = world.res_mut::<crate::resources::ViewerResources>();
+    let result = result.map(|()| state(&viewer.camera_views));
+    viewer.operations.finish(id, viewer.history.frame, result);
+}
