+                systems::library::draw_previews,
+                systems::lists::rebuild_lists,
+                systems::refresh::refresh_ui,
+                systems::nav_gizmo::draw_nav_gizmo,
+            ),
+        );
+        let schedule = app.stages.stage_mut(Stage::Update.name());
+        macro_rules! order {
+            ($a:path,$b:path) => {
+                schedule.order(
+                    std::any::type_name_of_val(&$a),
+                    std::any::type_name_of_val(&$b),
+                );
+            };
+        }
+        order!(systems::input::handle_events, systems::interface::relayout);
+        order!(systems::interface::relayout, systems::poll::poll_ui);
+        order!(systems::poll::poll_ui, native_pointer_capture);
+        order!(native_pointer_capture, systems::gizmo::update_gizmo);
+        order!(
+            systems::browsers::announce_indices,
+            systems::browsers::poll_browsers
