+#[cfg(test)]
+mod indirect_feature_tests {
+    use super::*;
+    #[test]
+    fn dx12_uses_offset_correct_indirect_draws_without_changing_vulkan_features() {
+        let mut info = wgpu::AdapterInfo {
+            name: "test".into(),
+            vendor: 0,
+            device: 0,
+            device_type: wgpu::DeviceType::Other,
+            device_pci_bus_id: String::new(),
+            driver: String::new(),
+            driver_info: String::new(),
+            backend: wgpu::Backend::Dx12,
+            subgroup_min_size: 0,
+            subgroup_max_size: 0,
+            transient_saves_memory: false,
+        };
+        let features =
+            wgpu::Features::INDIRECT_FIRST_INSTANCE | wgpu::Features::MULTI_DRAW_INDIRECT_COUNT;
+        let dx12 = negotiate_device_config(features, &wgpu::Limits::default(), &info);
+        assert!(
+            dx12.required_features
+                .contains(wgpu::Features::INDIRECT_FIRST_INSTANCE)
+        );
+        assert!(
+            !dx12
+                .required_features
+                .contains(wgpu::Features::MULTI_DRAW_INDIRECT_COUNT)
+        );
+        info.backend = wgpu::Backend::Vulkan;
+        let vulkan = negotiate_device_config(features, &wgpu::Limits::default(), &info);
+        assert!(
+            vulkan
+                .required_features
+                .contains(wgpu::Features::MULTI_DRAW_INDIRECT_COUNT)
+        );
+    }
+}
